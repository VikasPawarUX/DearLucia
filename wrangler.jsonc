{
  // The live site, https://www.vikaspawar.online/dearlucia/, is this assets-only Worker.
  // `pnpm deploy:site` builds into dist-site/dearlucia/ and swaps files with
  // `wrangler versions upload` + `versions deploy`, which never changes the domain routes.
  "name": "dear-lucia",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./dist-site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
